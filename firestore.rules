rules_version = '2';

// Who may read and write what.
//
// Two kinds of person use this app and they are not two kinds of account.
//
//   An EXPERT is signed in with a real credential. He writes his own boards
//   and the season they belong to, and that is what makes a broadcast board
//   the expert's own work rather than whatever the last viewer typed.
//
//   A VIEWER is anonymous. He gets a uid so the app can tell him from the next
//   viewer, and he gets NO write access to this database at all. His own
//   mock — his boards, his roster, his play-along — lives in his own browser.
//   That is a deliberate asymmetry, not a limitation waiting to be lifted:
//   ten experts' work is worth hosting, ten thousand viewers' is not, and a
//   viewer who can write is a viewer who can overwrite.
//
// The asymmetry is enforced HERE and nowhere else. `canEdit()` in the app is
// about what the interface offers; it is not a security boundary, because
// anything the browser decides, the browser can be made to decide differently.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // --- who is who -------------------------------------------------------
    //
    // ONE identity read per evaluation, and never two.
    //
    //   may this person act at all?  exists(email2author/{his email})  1 read
    //   which identity is he?        request.auth.uid                  free
    //   is this thing his?           a field == that uid               free
    //
    // That is the whole reason authors are keyed by the Firebase Auth uid:
    // "which author am I" is answered by the token itself, so no rule ever
    // has to look an author up to find out. `authors` is PROFILE DATA and is
    // never read for a permission decision anywhere in this file — including
    // its `deactivated` flag, which exists so the interface can say somebody
    // was revoked and for nothing else. Deleting the email2author entry is
    // what revokes; a flag that granted or withheld anything would be a
    // second, disagreeing answer to a question this file already answers.

    // Signed in with Google, with a verified email, and that email has an
    // email2author entry.
    //
    // Not just "not anonymous": the Firebase config in the deployed bundle is
    // public by design (see .env.example), and a project with more than one
    // sign-in method enabled would otherwise let anybody self-register a
    // password account claiming a listed expert's address and inherit his
    // access with no verification at all. Pinning the provider to google.com
    // closes that — a Google account's email is verified by Google itself,
    // which is also why email_verified is checked explicitly rather than
    // assumed from the provider.
    //
    // The email2author lookup is the LAST term on purpose, and is not hoisted
    // into a `let`: a `let` evaluates eagerly, before the short-circuit above
    // it, so `request.auth.token.email.lower()` would run for every anonymous
    // viewer and throw instead of denying cleanly.
    function isExpert() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/email2author/$(request.auth.token.email.lower()));
    }

    // Documents are stored with SHORT FIELD NAMES — see src/data/fieldNames.js,
    // where field names were 40-45% of storage. A rule reads what is actually
    // written, so ownership is `o`, not `ownerId`. Reading the long name did
    // not deny quietly: it raised "Property ownerId is undefined on object",
    // which denies EVERYTHING, and an expert could not write his own board.
    //
    //     board   g slug  l label  a authorId  o ownerId  s seasonId  v visibility
    //     author  n name  e email  x deactivated  c createdAt

    // The board being touched, as it is stored right now. Only for rules that
    // are NOT on the board document itself — inside `boards/{id}/entries`,
    // where the parent is a different document and a get() is the only way to
    // reach it. A rule ON `boards/{id}` uses `resource.data` instead, which is
    // the same bytes for free: get() is a billed document access, resource is
    // the document the request is already about.
    function boardNow(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    function boardExists(boardId) {
      return exists(/databases/$(database)/documents/boards/$(boardId));
    }

    // Whether an ownership pair (o, a) is ever safe to accept: `o` may only
    // be null (unowned) or the caller's own uid (self-claim), and self-
    // ownership additionally requires an author — a board with no author is
    // SHARED and must never be owned. One function for both create and
    // update so the two checks cannot drift the way they already did once
    // (create had no author guard at all until this fix let deleting and
    // recreating the shared board land it owned, bypassing update's guard
    // entirely). `a` means something different at each call site — the
    // INCOMING value on create (nothing else exists yet to check), the
    // board's value BEFORE this write on update (so a write cannot invent an
    // author in the same breath it claims with) — callers pass the right one.
    function ownershipWouldBeSafe(o, a) {
      return o == null || (o == request.auth.uid && a != null);
    }

    // Owned by ME, or SHARED (no author at all — consensus is the case that
    // matters, derived rather than written by a person). Any expert may
    // maintain a shared board. An ORPHANED board (has an author, o is null —
    // a personal board nobody has claimed yet) is deliberately NOT covered:
    // it is readable by any expert (see boardVisible) but writable by nobody
    // except the specific act of claiming it, which the boards update rule
    // carves out on its own.
    //
    // Takes the board's DATA rather than its id, so a rule on the board
    // document can hand it `resource.data` and pay nothing. ownsBoard(id)
    // below is the same question for callers that only have an id.
    function ownsBoardData(b) {
      return isExpert()
          && (b.o == request.auth.uid || b.a == null);
    }

    // The id-taking form, for `entries` and `ownsVoice` — the callers that
    // genuinely do not have the board document in hand. A board that does not
    // exist yet counts as writable so that `create` can function at all.
    function ownsBoard(boardId) {
      return isExpert()
          && (!boardExists(boardId) || ownsBoardData(boardNow(boardId)));
    }

    // Whether the person holding this board has had his access revoked.
    //
    // DERIVED, NEVER MAINTAINED. Ownership is not stripped when somebody is
    // revoked: his board keeps `o: <his uid>` and becomes claimable because
    // this asks live truth — "does that uid still have an invite" — rather
    // than because some earlier write remembered to orphan it. Two things
    // fall out of that and both are wanted. Reinstate him before anybody
    // claims the board and he simply owns it again, with no reassignment
    // step to run and nothing to have half-run. And a private board's `v` is
    // never rewritten, so its privacy comes back with him: there was never a
    // moment where the app decided on his behalf to downgrade it.
    //
    // Three reads at worst, and only ever on a branch the cheap checks have
    // already failed — a claim attempt on a board that is neither yours nor
    // orphaned, or a private board being read by somebody who is not its
    // owner. The two exists() calls are on DIFFERENT documents (his author,
    // his invite) so they do not dedupe against each other; the get() is the
    // same document as the first exists() and is cached.
    //
    // Every guard here is load-bearing, none of it is padding:
    //
    //   uid != null      an orphaned board reaches this with o == null, and
    //                    $(null) is not a document path.
    //   exists(author)   ensureAuthorRecord's failure path is deliberately
    //                    non-fatal (see utils/auth.js) — a man is an expert
    //                    because the invite says so, and can create boards
    //                    while having no author record at all. Without this,
    //                    get() returns null, `.data.e` throws, and a thrown
    //                    rule denies the WHOLE request, not just this branch.
    //   e != ''          same shape: an author without a stored address
    //                    cannot be resolved to an invite, and
    //                    exists(email2author/) is not a path either.
    //
    // All three fail CLOSED — not revoked, so not claimable, so the board
    // stays where it is. The safe direction for every one of them.
    function ownerRevoked(uid) {
      return uid != null
          && exists(/databases/$(database)/documents/authors/$(uid))
          && get(/databases/$(database)/documents/authors/$(uid)).data.get('e', '') != ''
          && !exists(/databases/$(database)/documents/email2author/$(get(/databases/$(database)/documents/authors/$(uid)).data.e));
    }

    // The same question about an AUTHOR — and it costs nothing, because an
    // author IS a person: the document key is that person's uid, so "is this
    // author me" is a string comparison against the token and never a read.
    // There is no ownership field on an author any more and nothing to look
    // up; being the author and being the signed-in person are the same fact.
    function ownsAuthor(authorId) {
      return isExpert() && authorId == request.auth.uid;
    }

    // Whose voice an evaluation is in. It is keyed by AUTHOR for a personal
    // board — one man's view of a player runs across every season, while the
    // boards he built along the way are separate artifacts — and by BOARD only
    // for consensus, which has no person behind it. So both have to be
    // checked, and the board half has to EXIST: this deliberately does not
    // inherit ownsBoard's "a board that does not exist yet is yours", which is
    // there so a board can be created and would otherwise mean an author id,
    // which is never a board id, made every expert the owner of every
    // evaluation.
    //
    // The author half is free (see ownsAuthor) and is tried first, so the
    // common case — a man writing in his own voice — costs no reads at all.
    //
    // A SEEDED author (Dan, Ryan) is keyed by an opaque id rather than a uid,
    // because nobody ever signs in as them. ownsAuthor can therefore never
    // match one, so their voices are read-only for everybody. That is
    // deliberate: they are placeholders, not people with accounts.
    function ownsVoice(voiceId) {
      return ownsAuthor(voiceId)
          || (boardExists(voiceId) && ownsBoard(voiceId));
    }

    // Whether this board's ENTRIES (the rankings themselves) are visible to
    // the caller. The board document is NOT gated this way — see the read
    // rule on /boards below — because a rule on a LISTED collection that
    // reads its own resource.data is evaluated once against an empty
    // stand-in: `.get(field, default)` silently returns the default and lets
    // the whole collection through (a leak), while a bare field read throws
    // and denies the whole collection (breaking every viewer's board list).
    // Measured against a real emulator, not theoretical. A get() on ONE
    // document, addressed by the path variable boardId, has neither failure
    // mode — which is why entries (queried per-board, one path variable) can
    // be gated this way and the boards collection (queried flat, no
    // per-document variable to key on) cannot.
    //
    // boardExists(boardId) is checked FIRST via short-circuit, same as
    // ownsBoard() above — never hoisted into a `let` ahead of it, which
    // would call boardNow() on a possibly-nonexistent document before
    // anything has asked whether it exists (see isExpert() for this exact
    // trap in a different function).
    function boardVisible(boardId) {
      return !boardExists(boardId)
          || boardNow(boardId).a == null   // shared/consensus: always public
          // orphaned (has an author, unowned): any expert, regardless of
          // whatever v is stored — an unclaimed board is not one person's
          // to keep private from the rest of the team.
          || (boardNow(boardId).o == null && isExpert())
          || boardNow(boardId).get('v', 'public') == 'public'
          || (isExpert() && boardNow(boardId).get('v', 'public') == 'expert')
          || (request.auth != null
              && boardNow(boardId).o == request.auth.uid
              && boardNow(boardId).get('v', 'public') == 'private')
          // A PRIVATE board whose owner has been revoked, read by any expert.
          //
          // Last on purpose: public and expert-tier boards short-circuit long
          // before here, so nobody pays ownerRevoked's reads for them, and an
          // owner reading his own private board is matched by the branch above
          // this one. Only a private board being read by somebody else gets
          // this far.
          //
          // Without it a revoked man's private board is readable by NOBODY —
          // the branch above needs o == request.auth.uid, and his uid is not
          // anybody else's. That is the same lockout already found and fixed
          // once this session by a different route (orphaning used to set o
          // to null, which made the orphaned branch above match); it would
          // have come straight back here, because not stripping ownership is
          // exactly what keeps that branch from matching.
          || (isExpert()
              && boardNow(boardId).get('v', 'public') == 'private'
              && ownerRevoked(boardNow(boardId).o));
    }

    // --- who may act as an expert at all -----------------------------------
    //
    // email2author/{email}  ->  { invitedBy, invitedAt }
    //
    // EXISTENCE IS THE PERMISSION. There is no active flag and nothing to
    // read inside the document for a decision: the entry is there or it is
    // not, and deleting it revokes access immediately and everywhere, on the
    // next request, with no stale token or cached claim to wait out.
    //
    // It is keyed by EMAIL rather than uid because it has to exist BEFORE its
    // person does. An invite is written for somebody who has never signed in,
    // so there is no uid to key it by yet — and that is exactly what breaks
    // the bootstrap circle: `authors/{uid}` cannot gate its own creation on
    // being an expert, so the invite, checked by an address that is on the
    // token from the very first request, gates it instead.
    //
    // The circular part that remains is the FIRST entry: creating one
    // requires isExpert(), and isExpert() requires one. That is intentional,
    // not a gap to close with a rule. A rule that could bootstrap itself
    // (e.g. "allowed if the collection is empty") cannot actually be written
    // here — rules have no primitive for collection emptiness, only
    // per-document exists()/get() — and the closest expressible version (a
    // sentinel "bootstrap done" doc) stays open from the moment the rules
    // deploy until the first person to notice uses it, on a site that is
    // already public. The first entry is seeded once, out of band, with
    // project-owner credentials that bypass these rules entirely — the same
    // access already needed to deploy the rules themselves. See
    // docs/FIREBASE.md.
    match /email2author/{email} {
      // Any signed-in Google user may check whether HIS OWN address is
      // invited — that read is what signInExpert() does before deciding
      // whether to keep the session — without being able to see who else is
      // invited until he is himself.
      allow read: if isExpert()
                  || (request.auth != null
                      && request.auth.token.email != null
                      && request.auth.token.email.lower() == email);
      // Who invited whom stays answerable from the data: invitedBy is the
      // caller's own address, and there is no update rule at all, so it can
      // never be rewritten afterwards.
      allow create: if isExpert()
                    && request.resource.data.invitedBy == request.auth.token.email.lower();
      allow update: if false;
      // Revocation. Any expert may revoke any other; the app refuses to
      // target your OWN entry (self-lockout), which the rule does not need
      // to enforce because either direction is fine for somebody else's.
      allow delete: if isExpert();
    }

    // --- the shared record ------------------------------------------------

    // Everyone reads. A viewer following a live draft has to see the board,
    // the players and the picks, and there is nothing private here — these are
    // published opinions about publicly available football players.
    //
    // Writing is an expert's. The registry is shared: a rename or a corrected
    // school is true for everybody, which is exactly why a viewer must not be
    // able to do it.

    match /players/{playerId} {
      allow read: if true;
      allow write: if isExpert();
    }

    // An author IS a person: the document key is his Firebase Auth uid, so
    // there is no ownership field and nothing to claim. He creates his own
    // record at first sign-in — which he can do because his email2author
    // entry already exists, and isExpert() only ever asks about that.
    //
    // `deactivated` is informational. Nothing in this file reads it to decide
    // anything; it is here so the interface can show that somebody's access
    // was revoked rather than having them silently vanish from the list.
    // Another expert may set it — and ONLY it — which is why the
    // not-me branch is a hasOnly(['x']) diff rather than a general write:
    // revoking somebody must not also be a licence to rename them.
    //
    // The collection legitimately holds two shapes. Real people are keyed by
    // uid. The shipped placeholders (Dan, Ryan) keep the opaque ids they were
    // seeded with, because nobody signs in as them — so `authorId ==
    // request.auth.uid` is simply never true for one, which is the correct
    // outcome and needs no special case.
    match /authors/{authorId} {
      allow read: if true;
      // Create and update carry the SAME self-check rather than one being
      // looser — create-vs-update drift is how a guard got bypassed here
      // once already (delete the document, recreate it without the guard).
      // `e` is FROZEN, and this is the load-bearing line of the whole
      // revocation model rather than a tidiness rule.
      //
      // ownerRevoked() derives "has this owner lost access" by following
      // board.o -> authors/{o}.e -> email2author/{e}. Leave `e` writable by
      // its own subject and that chain runs through a field the person being
      // revoked controls: one legitimate write before leaving, pointing `e`
      // at a COLLEAGUE'S address, and revoking him afterwards does nothing —
      // the lookup finds the colleague's live invite and reports him still
      // invited, permanently. His boards then cannot be claimed by anyone and
      // his private boards cannot be read by anyone, with no way back that
      // does not involve the Firebase console. Revocation state has to sit
      // where the person being revoked cannot reach it.
      //
      // On create it must equal the caller's own verified address, or the
      // same capture is available by writing the record wrong in the first
      // place. lower() to match how the invite is keyed and how
      // ensureAuthorRecord writes it.
      allow create: if isExpert()
                    && authorId == request.auth.uid
                    && request.resource.data.e == request.auth.token.email.lower();
      allow update: if isExpert()
                    && ((authorId == request.auth.uid
                         && request.resource.data.e == resource.data.e)
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x']));
      // An author is permanent. Deleting one would strand every evaluation
      // written in that voice and every board that names him.
      allow delete: if false;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isExpert();
      // Everything a season owns belongs to whoever may write the season:
      //   seasons/{id}/charts/{stage}/rows|bands   the depth charts
      //   seasons/{id}/stages/{base}               the prospect pool and its like
      //   seasons/{id}/setup/{season|facts}        the "already seeded" markers
      // All of them moved under the season precisely so this is one rule
      // rather than one per collection.
      match /{document=**} {
        allow read: if true;
        allow write: if isExpert();
      }
    }

    // --- boards, which have an owner --------------------------------------

    match /boards/{boardId} {
      allow read: if true;
      // Creating a board requires claiming it: an expert may not mint a board
      // owned by somebody else, which is the whole point of storing ownerId.
      //
      // A board with no authorId (a == null) is SHARED, not orphaned - the
      // consensus board is the case that matters, and it is meant to have no
      // owner ever, not just until somebody claims it. Checked here, not only
      // on update: creating a board is also how you CLAIM one, since deleting
      // an unowned board and recreating it lands on create, not update — the
      // exact path that let an expert delete the shared board and recreate it
      // solely owned before this rule existed. Both call ownershipWouldBeSafe
      // rather than writing the check inline twice, which is how that gap
      // opened in the first place: on the incoming data itself here, since
      // nothing else exists yet to check.
      allow create: if isExpert()
                    && ownershipWouldBeSafe(request.resource.data.o, request.resource.data.a);
      // Same shape, checked against the board's state BEFORE this write —
      // `resource.data`, which is the stored document and costs nothing,
      // rather than a get() on the document the request is already about.
      // An update cannot invent an author in the same breath it claims with.
      //
      // ownsBoardData covers an OWNED board (must be the owner) and a SHARED
      // one (any expert). It deliberately does NOT cover an ORPHANED board —
      // has an author, o is null — so the second clause carves out the one
      // write that IS allowed on one: claiming it, o going from null to
      // exactly the caller's own uid. ownershipWouldBeSafe still blocks
      // claiming on somebody else's behalf or a direct owned-to-owned
      // handoff (must pass through orphaned first).
      //
      // The claim carve-out needs isExpert() of its own — it does not inherit
      // it from ownsBoardData (that is the OTHER half of the ||). Its own
      // condition is just "was unowned, becomes exactly my own uid", which a
      // viewer satisfies by construction, their own real uid always being
      // equal to itself — caught live: a viewer's test uid is literally the
      // string 'anon', and setting o: 'anon' passed this clause.
      //
      // The third clause is the same carve-out for a board whose owner has
      // been REVOKED. He keeps it — ownership is never stripped — so the
      // second clause cannot match (o is his uid, not null), and without
      // this his board would be frozen: unwritable by him, because the
      // rules refuse everything he does now, and unclaimable by anybody
      // else, because claiming wanted o == null. Deriving it here instead
      // of orphaning on revoke is what makes reinstating him a no-op:
      // nothing was moved, so nothing has to be moved back.
      //
      // Every constraint on a normal claim still applies to this one. It is
      // guarded by ownershipWouldBeSafe exactly like the others, so a SHARED
      // board (no author) can never be claimed however its owner got that
      // way, and the explicit `== request.auth.uid` keeps it self-only —
      // nobody claims on a third party's behalf, and a revoked man's board
      // cannot be handed straight to somebody who was not asking for it.
      // `a` is FROZEN after creation, and without this the shared board can
      // be captured in TWO writes rather than one.
      //
      // ownershipWouldBeSafe reads `a` from the document BEFORE this write
      // and `o` from the incoming one, so it can only judge the regime a
      // board is already in. Nothing else constrained `a`, so an expert
      // could write `a: <himself>, o: null` to the consensus board — allowed,
      // because with `a` still null beforehand it is the shared board and any
      // expert may maintain it — and then claim it on a second write, because
      // by then `a` is set and it looks like an ordinary orphan. Then mark it
      // private and no other expert, and no viewer, can read the consensus
      // board again. Reproduced against the emulator; the single-write form
      // this file's tests used does fail, which is why the suite did not see
      // it.
      //
      // `a` selects which ownership regime a board is under, so a rule that
      // branches on its previous value is only an invariant if the same write
      // cannot change it. Authorship is also the answer to "whose opinion is
      // this", which is the question this whole app exists to keep straight —
      // it is set once by createBoard and nothing legitimately rewrites it.
      allow update: if request.resource.data.a == resource.data.a
                    && ownershipWouldBeSafe(request.resource.data.o, resource.data.a)
                    && (ownsBoardData(resource.data)
                        || (isExpert()
                            && resource.data.o == null
                            && request.resource.data.o == request.auth.uid)
                        || (isExpert()
                            && request.resource.data.o == request.auth.uid
                            && ownerRevoked(resource.data.o)));
      // Nobody may delete an orphaned board (ownsBoardData does not cover
      // it), which matches "written by nobody" — only claiming is exempted,
      // and deleting is not claiming.
      allow delete: if ownsBoardData(resource.data);

      // The placements — one line about one board, where a flat collection
      // with a boardId field would need a predicate holding for every document
      // a query might touch.
      //
      // The board must EXIST. ownsBoard alone says yes for a board that does
      // not — which is deliberate there, so that a board can be created — and
      // would otherwise let anybody scatter entries under ids belonging to no
      // board at all.
      match /entries/{playerId} {
        // The content a visibility setting actually hides. See
        // boardVisible() above for why this is where the gate lives instead
        // of on the board document itself.
        allow read: if boardVisible(boardId);
        allow write: if boardExists(boardId) && ownsBoard(boardId);
      }
    }

    // --- evaluations ------------------------------------------------------

    // evaluations/{playerId}/remarks/{ownerId}
    //
    // This is the clearest case for paths in the whole file. It used to be one
    // flat collection keyed {ownerId}__{playerId}, and the rule had to SPLIT
    // that key to find out whose voice it was — which is how it came to be
    // wrong: the left half is an author id for a personal board, the lookup
    // went to /boards, found nothing, and every expert could overwrite every
    // other expert's evaluations.
    //
    // The owner is a path variable now. There is nothing to parse and nothing
    // to get wrong — and since an author id IS a uid, matching it against the
    // caller costs no read either.
    //
    // Season and kind are keys inside the document rather than path levels —
    // at a full season, splitting them out cost 183,750 characters of
    // collection key and bought nothing. A remark is stamped with the season
    // it was written in rather than owned by it, which is why none of this
    // sits under /seasons.
    match /evaluations/{playerId}/remarks/{ownerId} {
      allow read: if true;
      allow write: if ownsVoice(ownerId);
    }

    // --- the draft's own state ---------------------------------------------

    // Whose turn it is and which picks are ours, one document per season. The
    // selections themselves are not here — a pick is draftPick/team/draftYear
    // on the player, so it is governed by the /players rule.
    //
    // Kept flat rather than under the season because it is a single small
    // record read only by exact id, where a path would buy a collection
    // holding one document. It still needs a rule of its own: without one it
    // falls to the deny-all below and the draft cannot be written at all.
    match /draft_state/{seasonId} {
      allow read: if true;
      allow write: if isExpert();
    }

    // --- everything else --------------------------------------------------

    // Deny by default. A collection added later is unreachable until somebody
    // writes a rule for it, which is the right way round: the failure is a
    // permission error in development, not an open database in production.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
