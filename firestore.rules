rules_version = '2';

// Who may read and write what.
//
// Two kinds of person use this app and they are not two kinds of account.
//
//   An EXPERT is signed in with a real credential. He writes his own boards
//   and the season they belong to, and that is what makes a broadcast board
//   the expert's own work rather than whatever the last viewer typed.
//
//   A VIEWER is anonymous. He gets a uid so the app can tell him from the next
//   viewer, and he gets NO write access to this database at all. His own
//   mock — his boards, his roster, his play-along — lives in his own browser.
//   That is a deliberate asymmetry, not a limitation waiting to be lifted:
//   ten experts' work is worth hosting, ten thousand viewers' is not, and a
//   viewer who can write is a viewer who can overwrite.
//
// The asymmetry is enforced HERE and nowhere else. `canEdit()` in the app is
// about what the interface offers; it is not a security boundary, because
// anything the browser decides, the browser can be made to decide differently.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // --- who is who -------------------------------------------------------

    // Signed in with Google, with a verified email, and that email is on the
    // allowed_users list.
    //
    // Not just "not anonymous": the Firebase config in the deployed bundle is
    // public by design (see .env.example), and a project with more than one
    // sign-in method enabled would otherwise let anybody self-register a
    // password account claiming a listed expert's address and inherit his
    // access with no verification at all. Pinning the provider to google.com
    // closes that — a Google account's email is verified by Google itself,
    // which is also why email_verified is checked explicitly rather than
    // assumed from the provider.
    // The allowed_users doc is checked twice on purpose rather than hoisted
    // into a `let` — a `let` evaluates eagerly, before the short-circuit
    // above it, so `request.auth.token.email.lower()` would run for every
    // anonymous viewer and throw instead of denying cleanly. Same repeated-
    // get() shape ownsAuthor() already uses on one document; proven
    // tolerable against the access budget.
    function isExpert() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower()))
          // == true, not != false: active is meant to be a boolean, enforced
          // on write below, but a rule still has to decide what an already-
          // malformed value means. `!= false` let a stored string "false"
          // through, since it is never equal to the boolean false — `==
          // true` fails closed on anything that is not exactly the boolean
          // true, missing-defaults-true included.
          && get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower()))
               .data.get('active', true) == true;
    }

    // Documents are stored with SHORT FIELD NAMES — see src/data/fieldNames.js,
    // where field names were 40-45% of storage. A rule reads what is actually
    // written, so ownership is `o`, not `ownerId`. Reading the long name did
    // not deny quietly: it raised "Property ownerId is undefined on object",
    // which denies EVERYTHING, and an expert could not write his own board.
    //
    //     board   g slug  l label  a authorId  o ownerId  s seasonId  v visibility
    //     author  n name  o ownerId

    // The board being touched, as it is stored right now. Null for a board
    // that does not exist yet, which is what a creation looks like.
    function boardNow(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    function boardExists(boardId) {
      return exists(/databases/$(database)/documents/boards/$(boardId));
    }

    // Whether an ownership pair (o, a) is ever safe to accept: `o` may only
    // be null (unowned) or the caller's own uid (self-claim), and self-
    // ownership additionally requires an author — a board with no author is
    // SHARED and must never be owned. One function for both create and
    // update so the two checks cannot drift the way they already did once
    // (create had no author guard at all until this fix let deleting and
    // recreating the shared board land it owned, bypassing update's guard
    // entirely). `a` means something different at each call site — the
    // INCOMING value on create (nothing else exists yet to check), the
    // board's value BEFORE this write on update (so a write cannot invent an
    // author in the same breath it claims with) — callers pass the right one.
    function ownershipWouldBeSafe(o, a) {
      return o == null || (o == request.auth.uid && a != null);
    }

    // Owned by ME, or SHARED (no author at all — consensus is the case that
    // matters, derived rather than written by a person). Any expert may
    // maintain a shared board. An ORPHANED board (has an author, o is null —
    // a personal board nobody has claimed yet) is deliberately NOT covered
    // here: it is readable by any expert (see boardVisible) but writable by
    // nobody except the specific act of claiming it, which the boards
    // update rule below carves out on its own rather than through this
    // function. A board that does not exist yet counts as writable so that
    // `create` can function at all.
    function ownsBoard(boardId) {
      return isExpert()
          && (!boardExists(boardId)
              || boardNow(boardId).o == request.auth.uid
              || boardNow(boardId).a == null);
    }

    // The same question about an AUTHOR, who is a person rather than a
    // board and so has no "shared, always-writable" case — every author
    // that exists represents someone real. An orphaned (unclaimed) author
    // is writable by nobody, same reasoning as an orphaned board, carved
    // out on its own in the authors update rule below.
    function ownsAuthor(authorId) {
      return isExpert()
          && exists(/databases/$(database)/documents/authors/$(authorId))
          && get(/databases/$(database)/documents/authors/$(authorId)).data.o == request.auth.uid;
    }

    // Whose voice an evaluation is in. It is keyed by AUTHOR for a personal
    // board — one man's view of a player runs across every season, while the
    // boards he built along the way are separate artifacts — and by BOARD only
    // for consensus, which has no person behind it. So both have to be
    // checked, and both have to EXIST: this deliberately does not inherit
    // ownsBoard's "a board that does not exist yet is yours", which is there
    // so a board can be created and would otherwise mean an author id, which
    // is never a board id, made every expert the owner of every evaluation.
    function ownsVoice(voiceId) {
      return ownsAuthor(voiceId)
          || (boardExists(voiceId) && ownsBoard(voiceId));
    }

    // Whether this board's ENTRIES (the rankings themselves) are visible to
    // the caller. The board document is NOT gated this way — see the read
    // rule on /boards below — because a rule on a LISTED collection that
    // reads its own resource.data is evaluated once against an empty
    // stand-in: `.get(field, default)` silently returns the default and lets
    // the whole collection through (a leak), while a bare field read throws
    // and denies the whole collection (breaking every viewer's board list).
    // Measured against a real emulator, not theoretical. A get() on ONE
    // document, addressed by the path variable boardId, has neither failure
    // mode — which is why entries (queried per-board, one path variable) can
    // be gated this way and the boards collection (queried flat, no
    // per-document variable to key on) cannot.
    //
    // boardExists(boardId) is checked FIRST via short-circuit, same as
    // ownsBoard() above — never hoisted into a `let` ahead of it, which
    // would call boardNow() on a possibly-nonexistent document before
    // anything has asked whether it exists (see isExpert()'s active-flag
    // check for this exact trap in a different function).
    function boardVisible(boardId) {
      return !boardExists(boardId)
          || boardNow(boardId).a == null   // shared/consensus: always public
          // orphaned (has an author, unowned): any expert, regardless of
          // whatever v is stored — an unclaimed board is not one person's
          // to keep private from the rest of the team.
          || (boardNow(boardId).o == null && isExpert())
          || boardNow(boardId).get('v', 'public') == 'public'
          || (isExpert() && boardNow(boardId).get('v', 'public') == 'expert')
          || (request.auth != null
              && boardNow(boardId).o == request.auth.uid
              && boardNow(boardId).get('v', 'public') == 'private');
    }

    // --- the shared record ------------------------------------------------

    // Everyone reads. A viewer following a live draft has to see the board,
    // the players and the picks, and there is nothing private here — these are
    // published opinions about publicly available football players.
    //
    // Writing is an expert's. The registry is shared: a rename or a corrected
    // school is true for everybody, which is exactly why a viewer must not be
    // able to do it.

    // --- who may sign in as an expert at all -------------------------------
    //
    // The circular part: creating an entry requires isExpert(), and isExpert()
    // requires an entry — so the very first one can never be created through
    // the app. That is intentional, not a gap to close with a rule. A rule
    // that could bootstrap itself (e.g. "allowed if the collection is empty")
    // cannot actually be written here — rules have no primitive for collection
    // emptiness, only per-document exists()/get() — and the closest expressible
    // version (a sentinel "bootstrap done" doc) stays open from the moment the
    // rules deploy until the first person to notice uses it, on a site that is
    // already public. The first entry is seeded once, out of band, with
    // project-owner credentials that bypass these rules entirely — the same
    // access already needed to deploy the rules themselves. See docs/FIREBASE.md.
    //
    // Once seeded, who-added-whom is immutable — email/addedBy/addedAt can
    // never change after create — so "who let this person in" stays
    // answerable from the data itself. What CAN change is `active`: any
    // expert may deactivate or reactivate any OTHER entry (the app enforces
    // not-yourself client-side, to avoid self-lockout/self-unlock; the rule
    // does not need to, since either direction is fine for someone else's
    // entry). Removing an entry outright is still a console operation.
    match /allowed_users/{email} {
      // Any signed-in Google user may check whether HIS OWN address is
      // listed — that read is what signInExpert() does before deciding
      // whether to keep the session — without being able to see who else is
      // on the list until he is on it himself. This also means a deactivated
      // expert can still read his own entry and see active: false, rather
      // than the read simply stopping.
      allow read: if isExpert()
                  || (request.auth != null
                      && request.auth.token.email != null
                      && request.auth.token.email.lower() == email);
      allow create: if isExpert()
                    && request.resource.data.email == email
                    && request.resource.data.addedBy == request.auth.token.email.lower();
      // hasOnly(['active']) covers active being added, removed or changed —
      // not just rewritten — and admits the empty set (a no-op write)
      // harmlessly. `create` stays a separate rule on purpose: folding this
      // into `allow create, update` would block creating a new expert, which
      // legitimately writes email/addedBy/addedAt together.
      allow update: if isExpert()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
                    && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isExpert();
    }

    // An author is a PERSON, and an expert may only be himself. Claiming an
    // author on creation is what later lets a rule decide who may write that
    // person's evaluations; letting any expert rewrite any author would hand
    // over the evaluations with it.
    match /authors/{authorId} {
      allow read: if true;
      // Every author document that exists represents a real named person —
      // there is no "shared, never-owned" author the way consensus is a
      // shared board — so the second argument is always `true`: nothing
      // beyond "o is null or my own uid" ever needs checking here. Passed
      // through ownershipWouldBeSafe anyway rather than writing the o-only
      // check inline a second time, which is exactly how create and update
      // drifted apart on the boards side below.
      allow create: if isExpert()
                    && ownershipWouldBeSafe(request.resource.data.o, true);
      // ownsAuthor refuses anyone but the actual owner of an OWNED author,
      // and (since it no longer treats o == null as writable by any expert)
      // refuses everyone on an ORPHANED one too — except the one write this
      // carve-out exists for: claiming it, o going from null to exactly the
      // caller's own uid. ownershipWouldBeSafe still blocks a direct
      // owned-to-owned handoff (o may only become null or the caller's own
      // uid, never a third uid) and claiming on somebody else's behalf.
      // The claim carve-out needs isExpert() of its own — it does not
      // inherit it from ownsAuthor() (that's the OTHER half of the ||). Its
      // own condition is just "was unowned, becomes exactly my own uid",
      // which a signed-in-but-unlisted account or even a viewer can satisfy
      // by construction (their own real uid always equals itself) — caught
      // live: a viewer's test uid is literally the string 'anon', and
      // setting o: 'anon' passed this clause with no expert check at all.
      allow update: if ownershipWouldBeSafe(request.resource.data.o, true)
                    && (ownsAuthor(authorId)
                        || (isExpert()
                            && get(/databases/$(database)/documents/authors/$(authorId)).data.o == null
                            && request.resource.data.o == request.auth.uid));
      allow delete: if ownsAuthor(authorId);
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isExpert();
      // Everything a season owns belongs to whoever may write the season:
      //   seasons/{id}/charts/{stage}/rows|bands   the depth charts
      //   seasons/{id}/stages/{base}               the prospect pool and its like
      //   seasons/{id}/setup/{season|facts}        the "already seeded" markers
      // All of them moved under the season precisely so this is one rule
      // rather than one per collection.
      match /{document=**} {
        allow read: if true;
        allow write: if isExpert();
      }
    }

    // --- boards, which have an owner --------------------------------------

    match /boards/{boardId} {
      allow read: if true;
      // Creating a board requires claiming it: an expert may not mint a board
      // owned by somebody else, which is the whole point of storing ownerId.
      //
      // A board with no authorId (a == null) is SHARED, not orphaned - the
      // consensus board is the case that matters, and it is meant to have no
      // owner ever, not just until somebody claims it. Checked here, not only
      // on update: creating a board is also how you CLAIM one, since deleting
      // an unowned board and recreating it lands on create, not update — the
      // exact path that let an expert delete the shared board and recreate it
      // solely owned before this rule existed. Both call ownershipWouldBeSafe
      // rather than writing the check inline twice, which is how that gap
      // opened in the first place: on the incoming data itself here, since
      // nothing else exists yet to check.
      allow create: if isExpert()
                    && ownershipWouldBeSafe(request.resource.data.o, request.resource.data.a);
      // Same shape, checked against the board's state BEFORE this write
      // (boardNow) rather than the incoming data, since an update cannot
      // invent an author in the same breath it claims with.
      //
      // ownsBoard covers an OWNED board (must be the owner) and a SHARED one
      // (any expert). It deliberately does NOT cover an ORPHANED board — has
      // an author, o is null — so the second clause here carves out the one
      // write that's allowed on one anyway: claiming it, o going from null
      // to exactly the caller's own uid. ownershipWouldBeSafe still blocks
      // claiming on somebody else's behalf or a direct owned-to-owned
      // handoff (must pass through orphaned first).
      // The claim carve-out needs isExpert() of its own — see the identical
      // note on authors' update rule above; caught live by a viewer test
      // (their own real uid trivially equals itself, no expert check
      // otherwise gates this clause).
      allow update: if ownershipWouldBeSafe(request.resource.data.o, boardNow(boardId).a)
                    && (ownsBoard(boardId)
                        || (isExpert()
                            && boardNow(boardId).o == null
                            && request.resource.data.o == request.auth.uid));
      // Nobody may delete an orphaned board (ownsBoard no longer covers it),
      // which matches "written by nobody" - only claiming is exempted, and
      // deleting is not claiming.
      allow delete: if ownsBoard(boardId);

      // The placements — one line about one board, where a flat collection
      // with a boardId field would need a predicate holding for every document
      // a query might touch.
      //
      // The board must EXIST. ownsBoard alone says yes for a board that does
      // not — which is deliberate there, so that a board can be created — and
      // would otherwise let anybody scatter entries under ids belonging to no
      // board at all.
      match /entries/{playerId} {
        // The content a visibility setting actually hides. See
        // boardVisible() above for why this is where the gate lives instead
        // of on the board document itself.
        allow read: if boardVisible(boardId);
        allow write: if boardExists(boardId) && ownsBoard(boardId);
      }
    }

    // --- evaluations ------------------------------------------------------

    // evaluations/{playerId}/remarks/{ownerId}
    //
    // This is the clearest case for paths in the whole file. It used to be one
    // flat collection keyed {ownerId}__{playerId}, and the rule had to SPLIT
    // that key to find out whose voice it was — which is how it came to be
    // wrong: the left half is an author id for a personal board, the lookup
    // went to /boards, found nothing, and every expert could overwrite every
    // other expert's evaluations.
    //
    // The owner is a path variable now. There is nothing to parse and nothing
    // to get wrong.
    //
    // Season and kind are keys inside the document rather than path levels —
    // at a full season, splitting them out cost 183,750 characters of
    // collection key and bought nothing. A remark is stamped with the season
    // it was written in rather than owned by it, which is why none of this
    // sits under /seasons.
    match /evaluations/{playerId}/remarks/{ownerId} {
      allow read: if true;
      allow write: if ownsVoice(ownerId);
    }

    // --- the draft's own state ---------------------------------------------

    // Whose turn it is and which picks are ours, one document per season. The
    // selections themselves are not here — a pick is draftPick/team/draftYear
    // on the player, so it is governed by the /players rule.
    //
    // Kept flat rather than under the season because it is a single small
    // record read only by exact id, where a path would buy a collection
    // holding one document. It still needs a rule of its own: without one it
    // falls to the deny-all below and the draft cannot be written at all.
    match /draft_state/{seasonId} {
      allow read: if true;
      allow write: if isExpert();
    }

    // --- everything else --------------------------------------------------

    // Deny by default. A collection added later is unreachable until somebody
    // writes a rule for it, which is the right way round: the failure is a
    // permission error in development, not an open database in production.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
